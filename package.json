{
  "name": "usshtc107",
  "version": "1.2.2",
  "description": "USTC computing platform SSH proxy client",
  "author": "Enthusjast <enthusjast@outlook.com>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Enthusjast/usshtc-107.git"
  },
  "desktopName": "usshtc107.desktop",
  "packageManager": "npm@11.18.0",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=true electron .\"",
    "build": "vite build",
    "check": "npm run check:electron && npm test && npm run build",
    "check:electron": "node scripts/check-electron.cjs",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node scripts/run-node-tests.cjs",
    "test:node:coverage": "node scripts/run-node-tests.cjs --experimental-test-coverage --test-coverage-include=electron/*.js --test-coverage-include=shared/*.mjs --test-coverage-exclude=electron/main.js --test-coverage-exclude=electron/preload.js --test-coverage-lines=80 --test-coverage-branches=60 --test-coverage-functions=78",
    "test:ui": "vitest run",
    "test:ui:coverage": "vitest run --coverage",
    "test:electron": "playwright test --project=source",
    "test:electron:packaged": "playwright test --project=packaged",
    "test:coverage": "npm run test:node:coverage && npm run test:ui:coverage",
    "start": "electron .",
    "build:mac-icon": "set -eu; iconset=build/icon.iconset; mkdir -p \"$iconset\"; for size in 16 32 128 256 512; do double=$((size * 2)); sips -z \"$size\" \"$size\" build/icon.png --out \"$iconset/icon_${size}x${size}.png\" >/dev/null; sips -z \"$double\" \"$double\" build/icon.png --out \"$iconset/icon_${size}x${size}@2x.png\" >/dev/null; done; iconutil -c icns \"$iconset\" -o build/icon.icns",
    "package:smoke": "npm run build && electron-builder --linux --dir --publish never",
    "dist": "vite build && electron-builder --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "dist:mac": "vite build && npm run build:mac-icon && electron-builder --mac --publish never",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2",
    "semver": "7.8.5",
    "electron-log": "^5.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "10.0.6",
    "cross-env": "^7.0.3",
    "electron": "43.8.3",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "axios@1": "1.20.0",
    "follow-redirects@1": "1.16.1",
    "fast-uri@3": "3.1.9",
    "http-cache-semantics@4": "4.3.0",
    "joi@18": "18.3.0",
    "js-yaml@4": "4.3.2",
    "nanoid@3": "3.3.20",
    "source-map-js@1": "1.2.2",
    "undici@6": "6.29.1",
    "undici@7": "7.30.1",
    "minimatch@3": { ".": "3.1.5", "brace-expansion": "1.1.21" },
    "minimatch@5": { ".": "5.1.9", "brace-expansion": "2.1.7" },
    "minimatch@9": { ".": "9.0.9", "brace-expansion": "2.1.7" },
    "minimatch@10": { ".": "10.2.6", "brace-expansion": "5.0.12" }
  },
  "allowScripts": {
    "cpu-features": false,
    "electron-winstaller": false,
    "esbuild@0.25.12": true,
    "fsevents": false,
    "ssh2": false
  }
}
